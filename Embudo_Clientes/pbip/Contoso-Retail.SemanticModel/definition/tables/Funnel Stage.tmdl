/// Stages of a customer funnel for the funnel view: all registered customers, those who bought in the period,
/// and those who came back for 4, 6 and 8 or more orders. A disconnected table; the measure reads the stage.
table 'Funnel Stage'
	lineageTag: e18e72cb-2abf-4148-ac66-d20924fd48b5

	/// Customers at each stage of 'Funnel Stage': all registered customers, then the buyers in the period with at least
	/// MinOrders orders. Blank outside a stage.
	measure 'Funnel Customers' =
			VAR k = SELECTEDVALUE ( 'Funnel Stage'[MinOrders] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( k ), BLANK (),
			        k < 0, COUNTROWS ( DimCustomer ),
			        k <= 1, [Distinct Customers],
			        COUNTROWS ( FILTER ( VALUES ( FactSales[CustomerKey] ), CALCULATE ( DISTINCTCOUNT ( FactSales[OrderKey] ) ) >= k ) )
			    )
		formatString: #,0
		lineageTag: c72ea7ef-471f-45b8-9f6b-7745b1ab20c2

	/// Customer funnel from all registered customers to those with 8+ orders: each stage's customers, its share of the first stage and the step conversion; the biggest drop in red. By CSalcedoDataBI.
	measure 'HTML Funnel Customers' =
			VAR _st = ADDCOLUMNS ( ALL ( 'Funnel Stage' ), "@v", [Funnel Customers] + 0 )
			VAR _first = MAXX ( FILTER ( _st, 'Funnel Stage'[StageOrder] = 1 ), [@v] )
			VAR _steps =
			    ADDCOLUMNS (
			        _st,
			        "@prev", VAR o = 'Funnel Stage'[StageOrder] RETURN MAXX ( FILTER ( _st, 'Funnel Stage'[StageOrder] = o - 1 ), [@v] ),
			        "@name", 'Funnel Stage'[Stage] & ""
			    )
			VAR _conv = ADDCOLUMNS ( _steps, "@step", DIVIDE ( [@v], [@prev] ) )
			VAR _worst = MINX ( FILTER ( _conv, NOT ISBLANK ( [@step] ) ), [@step] )
			RETURN
			    "<div style=""font-family:'Segoe UI',sans-serif;color:#334155;width:100%;height:100%;display:flex;flex-direction:column""> "
			        & "<div style=""font-size:15px;font-weight:600;color:#1F3A5F;margin:2px 0 2px 4px"">Customers by funnel stage</div> "
			        & "<div style=""font-size:11px;color:#64748B;margin:0 0 6px 4px"">The last stage keeps " & FORMAT ( DIVIDE ( MINX ( _st, [@v] ), _first ), "0.0%", "en-US" ) & " of the first · biggest drop in red (" & FORMAT ( 1 - _worst, "0%", "en-US" ) & " lost in one step)</div> "
			        & "<svg viewBox=""0 0 1000 560"" preserveAspectRatio=""xMidYMid meet"" style=""flex:1;width:100%""> "
			        & "<text x=""20"" y=""22"" font-size=""11"" font-weight=""600"" fill=""#64748B"">STAGE</text> "
			        & "<text x=""830"" y=""22"" text-anchor=""end"" font-size=""11"" font-weight=""600"" fill=""#64748B"">OF FIRST</text> "
			        & "<text x=""980"" y=""22"" text-anchor=""end"" font-size=""11"" font-weight=""600"" fill=""#64748B"">STEP</text> "
			        & CONCATENATEX (
			            _conv,
			            "<rect x=""" & ROUND ( 480 - DIVIDE ( [@v], _first ) * 260, 0 ) & """ y=""" & ROUND ( 40 + ( 'Funnel Stage'[StageOrder] - 1 ) * 102, 0 ) & """ width=""" & ROUND ( MAX ( 4, DIVIDE ( [@v], _first ) * 520 ), 0 ) & """ height=""74"" rx=""6"" fill=""" & IF ( NOT ISBLANK ( [@step] ) && [@step] = _worst, "#D64545", "#1F3A5F" ) & """ fill-opacity=""" & FORMAT ( 1 - ( 'Funnel Stage'[StageOrder] - 1 ) * 0.12, "0.00", "en-US" ) & """><title>" & [@name] & ": " & FORMAT ( [@v], "#,0", "en-US" ) & " customers</title></rect> "
			                & "<text x=""" & 480 & """ y=""" & ROUND ( 84 + ( 'Funnel Stage'[StageOrder] - 1 ) * 102, 0 ) & """ text-anchor=""middle"" font-size=""16"" font-weight=""700"" fill=""#FFFFFF"">" & FORMAT ( [@v], "#,0", "en-US" ) & "</text> "
			                & "<text x=""20"" y=""" & ROUND ( 82 + ( 'Funnel Stage'[StageOrder] - 1 ) * 102, 0 ) & """ font-size=""14"" font-weight=""600"" fill=""#334155"">" & [@name] & "</text> "
			                & "<text x=""830"" y=""" & ROUND ( 82 + ( 'Funnel Stage'[StageOrder] - 1 ) * 102, 0 ) & """ text-anchor=""end"" font-size=""14"" fill=""#334155"">" & FORMAT ( DIVIDE ( [@v], _first ), "0.0%", "en-US" ) & "</text> "
			                & "<text x=""980"" y=""" & ROUND ( 82 + ( 'Funnel Stage'[StageOrder] - 1 ) * 102, 0 ) & """ text-anchor=""end"" font-size=""14"" font-weight=""600"" fill=""" & IF ( NOT ISBLANK ( [@step] ) && [@step] = _worst, "#B42318", "#64748B" ) & """>" & IF ( ISBLANK ( [@step] ), "–", FORMAT ( [@step], "0.0%", "en-US" ) ) & "</text>",
			            "",
			            'Funnel Stage'[StageOrder], ASC
			        ) & " "
			        & "</svg> "
			        & "</div>"
		lineageTag: 5e1c0a00-0000-4000-8000-000000000012

	column Stage
		dataType: string
		lineageTag: 28a9f32a-593a-4582-b244-5d2e6dd4ae50
		summarizeBy: none
		sourceColumn: [Stage]
		sortByColumn: StageOrder

		annotation SummarizationSetBy = User

	column StageOrder
		dataType: int64
		formatString: 0
		lineageTag: c2c4a459-09cf-49a5-a9c9-40d66eccb7dc
		summarizeBy: none
		sourceColumn: [StageOrder]

		annotation SummarizationSetBy = User

	column MinOrders
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 586724a2-5819-4dfe-9dee-f93193729ba8
		summarizeBy: none
		sourceColumn: [MinOrders]

		annotation SummarizationSetBy = User

	partition 'Funnel Stage' = calculated
		mode: import
		source = DATATABLE("Stage", STRING, "StageOrder", INTEGER, "MinOrders", INTEGER, {{"All customers", 1, -1}, {"Bought", 2, 1}, {"4+ orders", 3, 4}, {"6+ orders", 4, 6}, {"8+ orders", 5, 8}})

