/// Store / channel dimension — one row per store. CountryName + Description identify the store; Status marks open vs closed.
table DimStore
	lineageTag: 60755083-e2a1-59ab-87a9-7146898bc97f

	/// Surrogate store key. Joins to FactSales[StoreKey].
	column StoreKey
		isHidden
		dataType: int64
		lineageTag: 704150b7-e55f-536a-8dc2-7dc619bdadc0
		summarizeBy: none
		sourceColumn: StoreKey

	/// Business store code.
	column StoreCode
		dataType: int64
		lineageTag: db86e6ef-6c99-5b83-ae04-89b18f83ccf1
		summarizeBy: none
		sourceColumn: StoreCode

	/// Store country code.
	column CountryCode
		dataType: string
		lineageTag: fbab33ae-5282-5872-b549-d34da8d2ce88
		sourceColumn: CountryCode

	/// Store country — common geography breakdown.
	column CountryName
		dataType: string
		lineageTag: 1738df57-e3d8-546c-956e-423f06f716b8
		sourceColumn: CountryName

	/// Store state / province.
	column State
		dataType: string
		lineageTag: e71432e0-3da6-5705-829f-c0982e5c21fc
		sourceColumn: State

	/// Store opening date.
	column OpenDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: ae22be4e-d89b-57d9-aa05-2a47496c95b0
		sourceColumn: OpenDate

		annotation UnderlyingDateTimeDataType = Date

	/// Store closing date (blank if still open).
	column CloseDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: f16977b4-f963-5bd1-8c56-985893be245c
		sourceColumn: CloseDate

		annotation UnderlyingDateTimeDataType = Date

	/// Store name / description — the natural label for a store.
	column Description
		dataType: string
		lineageTag: c659b5e7-9863-5f1c-9c38-ad198662e62c
		sourceColumn: Description

	/// Store floor area in square meters.
	column SquareMeters
		dataType: int64
		lineageTag: ef99408e-9e64-575d-a8bb-6ff3a8c590a3
		summarizeBy: none
		sourceColumn: SquareMeters

	/// Store status (e.g., Open, Closed).
	column Status
		dataType: string
		lineageTag: ebbec8f8-eece-5786-96c2-43b377fb0fa0
		sourceColumn: Status

	/// Yes when the store opened at least twelve full months before the period and is still open; same-store sales count only these.
	column 'Comparable Store'
		dataType: string
		lineageTag: 61c8c21c-c108-5c03-9d1b-e4bee70711d9
		summarizeBy: none
		sourceColumn: Comparable Store

		annotation SummarizationSetBy = Automatic

	partition DimStore = m
		mode: import
		source =
				let
				    // the query the model already had, unchanged; what follows the ETL added (ADR 0036)
				    #"Model query" =
				        let
				        	Source = Parquet.Document(Binary.Buffer(Web.Contents(DataBaseUrl, [RelativePath="DimStore.parquet"]))),
				        	Typed = VEDAFXChangeType(Source, {{"OpenDate", type date}, {"CloseDate", type date}})
				        in
				        	Typed,
				    // analysis column: a readable flag, not 1/0; an empty value lands in 'No data'
				    #"Comparable Store by OpenDate" =
				        Table.AddColumn(#"Model query", "Comparable Store", each if [OpenDate] = null then "No data" else if [OpenDate] <= #date(2022, 12, 31) then "Yes" else "No", type text),
				    // Columns no measure, relationship, report or meaning uses: removed here, upstream.
				    #"Unused columns removed" = Table.RemoveColumns(#"Comparable Store by OpenDate", {"GeoAreaKey", "Weight"}),
				    // English country names by CountryCode (the Parquet names are Spanish); a code not listed keeps its name
				    #"English country names" =
				        let
				            Names = [ONLINE = "Online Channel", MX = "Mexico", CO = "Colombia", AR = "Argentina", ES = "Spain", CL = "Chile", PE = "Peru", EC = "Ecuador"],
				            T = #"Unused columns removed"
				        in
				            Table.FromRecords(Table.TransformRows(T, each _ & [CountryName = Record.FieldOrDefault(Names, [CountryCode], [CountryName])]), Value.Type(T))
				in
				    #"English country names"

